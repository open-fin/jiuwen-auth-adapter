HTTP_ADDR=:8080
LOG_LEVEL=info

# Upstream identity provider (OIDC)
OIDC_ISSUER_URL=https://sso.example.com/realms/example
OIDC_CLIENT_ID=jiuwenswarm
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://auth.example.com/auth/callback
OIDC_SCOPES=openid,profile,email,groups

# Token accepted by JiuwenSwarm
INTERNAL_TOKEN_ISSUER=https://auth.example.com
INTERNAL_TOKEN_AUDIENCE=jiuwenswarm
INTERNAL_TOKEN_TTL=5m

# Portal handoff
PORTAL_EXCHANGE_ENABLED=false
PORTAL_EXCHANGE_URL=
